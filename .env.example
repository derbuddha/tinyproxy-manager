# Copy to `.env` next to docker-compose.yml and fill in. `.env` is gitignored -
# KEYCLOAK_CLIENT_SECRET is a credential and must not be committed.

# Name of the external Docker network the proxy and its clients share.
NETWORK_NAME=codersrv_default

# ---------------------------------------------------------------------------
# Optional Keycloak (OIDC) login for the web GUI - see keycloak.md
# ---------------------------------------------------------------------------
# Off by default. The GUI mounts the Docker socket, so leaving it unauthenticated
# on a reachable port gives anyone who finds it root-equivalent access.
KEYCLOAK_ENABLED=false

# Realm base URL - the part before /.well-known/openid-configuration
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/myrealm

# Confidential client ("Client authentication" on) with the GUI's
# https://<gui-domain>/auth-callback.php registered as a valid redirect URI.
KEYCLOAK_CLIENT_ID=tinyproxy-manager
KEYCLOAK_CLIENT_SECRET=

# The callback is served at BOTH /auth-callback.php and /sso/callback - register
# whichever you prefer in Keycloak. Set this only when the GUI cannot derive its
# own public URL from the request (a reverse proxy that strips
# X-Forwarded-Proto/Host), or when the registered URI differs from the URL you
# browse to - e.g. a non-default port or the /sso/callback path.
#KEYCLOAK_REDIRECT_URI=https://tinyproxy.example.com/sso/callback

# Restrict access to a dedicated group and/or role. Leave BOTH empty and every
# user the realm authenticates can control the proxy - strongly discouraged.
KEYCLOAK_ALLOWED_GROUPS=tinyproxy-admins
#KEYCLOAK_ALLOWED_ROLES=

# GUI session lifetime in seconds (default 43200 = 12h). When it lapses the
# browser is sent back through Keycloak - silently, if the SSO session is alive.
#KEYCLOAK_SESSION_TTL=43200
